<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc"
          version="2.5.3.0">

    <object class="wxFrame" name="MainFrame">
        <title>Download Manager</title>
        <size>1000,650</size>
        <centered>1</centered>

        <!-- ================================================== -->
        <!-- MENU                                               -->
        <!-- ================================================== -->

        <object class="wxMenuBar" name="menuBar">

            <object class="wxMenu" name="menuFile">
                <label>&amp;Arquivo</label>

                <object class="wxMenuItem" name="ID_ADD_DOWNLOAD">
                    <label>&amp;Adicionar download...\tCtrl+N</label>
                </object>

                <object class="wxMenuItem" name="ID_OPEN_FOLDER">
                    <label>Abrir pasta de downloads</label>
                </object>

                <object class="separator"/>

                <object class="wxMenuItem" name="wxID_EXIT">
                    <label>&amp;Sair\tCtrl+Q</label>
                </object>
            </object>

            <object class="wxMenu" name="menuDownload">
                <label>&amp;Download</label>

                <object class="wxMenuItem" name="ID_START">
                    <label>&amp;Iniciar</label>
                </object>

                <object class="wxMenuItem" name="ID_PAUSE">
                    <label>&amp;Pausar</label>
                </object>

                <object class="wxMenuItem" name="ID_CANCEL">
                    <label>&amp;Cancelar</label>
                </object>

                <object class="separator"/>

                <object class="wxMenuItem" name="ID_REMOVE">
                    <label>&amp;Remover</label>
                </object>
            </object>

            <object class="wxMenu" name="menuHelp">
                <label>A&amp;juda</label>

                <object class="wxMenuItem" name="wxID_ABOUT">
                    <label>&amp;Sobre</label>
                </object>
            </object>

        </object>


        <!-- ================================================== -->
        <!-- TOOLBAR                                            -->
        <!-- ================================================== -->

        <object class="wxToolBar" name="mainToolBar">

            <object class="tool" name="ID_ADD_DOWNLOAD">
                <label>Adicionar</label>
                <tooltip>Adicionar novo download</tooltip>
            </object>

            <object class="separator"/>

            <object class="tool" name="ID_START">
                <label>Iniciar</label>
                <tooltip>Iniciar ou continuar download</tooltip>
            </object>

            <object class="tool" name="ID_PAUSE">
                <label>Pausar</label>
                <tooltip>Pausar download</tooltip>
            </object>

            <object class="tool" name="ID_CANCEL">
                <label>Cancelar</label>
                <tooltip>Cancelar download</tooltip>
            </object>

            <object class="separator"/>

            <object class="tool" name="ID_REMOVE">
                <label>Remover</label>
                <tooltip>Remover download da lista</tooltip>
            </object>

        </object>


        <!-- ================================================== -->
        <!-- CONTEÚDO PRINCIPAL                                 -->
        <!-- ================================================== -->

        <object class="wxPanel" name="mainPanel">

            <object class="wxBoxSizer">
                <orient>wxVERTICAL</orient>

                <!-- Lista de downloads -->

                <object class="sizeritem">
                    <option>1</option>
                    <flag>wxEXPAND|wxALL</flag>
                    <border>8</border>

                    <object class="wxListCtrl" name="downloadList">
                        <style>
                            wxLC_REPORT|
                            wxLC_SINGLE_SEL|
                            wxLC_HRULES|
                            wxLC_VRULES
                        </style>
                    </object>
                </object>


                <!-- Informações -->

                <object class="sizeritem">
                    <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
                    <border>8</border>

                    <object class="wxStaticBoxSizer">
                        <orient>wxVERTICAL</orient>
                        <label>Download selecionado</label>


                        <!-- URL -->

                        <object class="sizeritem">
                            <flag>wxEXPAND|wxALL</flag>
                            <border>5</border>

                            <object class="wxBoxSizer">
                                <orient>wxHORIZONTAL</orient>

                                <object class="sizeritem">
                                    <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                    <border>8</border>

                                    <object class="wxStaticText">
                                        <label>URL:</label>
                                    </object>
                                </object>

                                <object class="sizeritem">
                                    <option>1</option>
                                    <flag>wxEXPAND</flag>

                                    <object class="wxTextCtrl"
                                            name="downloadUrl">
                                        <style>wxTE_READONLY</style>
                                    </object>
                                </object>

                            </object>
                        </object>


                        <!-- Destino -->

                        <object class="sizeritem">
                            <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
                            <border>5</border>

                            <object class="wxBoxSizer">
                                <orient>wxHORIZONTAL</orient>

                                <object class="sizeritem">
                                    <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                    <border>8</border>

                                    <object class="wxStaticText">
                                        <label>Destino:</label>
                                    </object>
                                </object>

                                <object class="sizeritem">
                                    <option>1</option>
                                    <flag>wxEXPAND</flag>

                                    <object class="wxTextCtrl"
                                            name="downloadDestination">
                                        <style>wxTE_READONLY</style>
                                    </object>
                                </object>

                            </object>
                        </object>


                        <!-- Barra de progresso -->

                        <object class="sizeritem">
                            <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
                            <border>5</border>

                            <object class="wxGauge" name="downloadProgress">
                                <range>100</range>
                                <value>0</value>
                            </object>

                        </object>


                        <!-- Informações -->

                        <object class="sizeritem">
                            <flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
                            <border>5</border>

                            <object class="wxBoxSizer">
                                <orient>wxHORIZONTAL</orient>

                                <object class="sizeritem">
                                    <option>1</option>

                                    <object class="wxStaticText"
                                            name="downloadSize">
                                        <label>0 B / 0 B</label>
                                    </object>
                                </object>

                                <object class="sizeritem">
                                    <flag>wxRIGHT</flag>
                                    <border>20</border>

                                    <object class="wxStaticText"
                                            name="downloadSpeed">
                                        <label>0 B/s</label>
                                    </object>
                                </object>

                                <object class="sizeritem">

                                    <object class="wxStaticText"
                                            name="downloadEta">
                                        <label>ETA: --:--</label>
                                    </object>

                                </object>

                            </object>
                        </object>

                    </object>
                </object>

            </object>
        </object>


        <!-- ================================================== -->
        <!-- STATUS BAR                                         -->
        <!-- ================================================== -->

        <object class="wxStatusBar" name="statusBar">
            <fields>2</fields>
            <widths>-1,200</widths>
        </object>

    </object>

</resource>
